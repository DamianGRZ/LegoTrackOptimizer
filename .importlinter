[importlinter]
root_packages =
    src_v2
include_external_packages = True

[importlinter:contract:layers]
name = Three-tier architecture (algorithm → EA → domain)
type = layers
layers =
    src_v2.runner
    (src_v2.problem) : (src_v2.operators) : (src_v2.decoder) : (src_v2.encoding) : (src_v2.repair) : (src_v2.sampling) : (src_v2.structural_mutations) : (src_v2.intersection)
    (src_v2.train) : (src_v2.geometry) : (src_v2.catalog) : (src_v2.types) : (src_v2.se2) : (src_v2.lego_track_models) : (src_v2.config)
exhaustive = false

[importlinter:contract:train-isolation]
name = train/ must not import EA or infrastructure code
type = forbidden
source_modules =
    src_v2.train
forbidden_modules =
    pymoo
    src_v2.decoder
    src_v2.operators
    src_v2.problem
    src_v2.runner
    src_v2.visualization
    src_v2.sampling
    src_v2.repair
    src_v2.encoding
    src_v2.structural_mutations

[importlinter:contract:catalog-isolation]
name = catalog/ must not import framework or EA code
type = forbidden
source_modules =
    src_v2.catalog
forbidden_modules =
    pymoo
    matplotlib
    src_v2.decoder
    src_v2.operators
    src_v2.problem
    src_v2.runner
    src_v2.visualization
    src_v2.sampling
    src_v2.repair
    src_v2.encoding
    src_v2.structural_mutations

[importlinter:contract:visualization-isolation]
name = visualization/ is a consumer of domain types, not of EA internals
type = forbidden
source_modules =
    src_v2.visualization
forbidden_modules =
    pymoo
    src_v2.operators
    src_v2.sampling
    src_v2.repair
    src_v2.runner
    src_v2.structural_mutations

[importlinter:contract:catalog-foundation]
name = Catalog is a leaf domain package — no upward imports
type = forbidden
source_modules =
    src_v2.catalog
forbidden_modules =
    src_v2.geometry
    src_v2.train
    src_v2.decoder
    src_v2.encoding
    src_v2.problem
    src_v2.operators
    src_v2.sampling
    src_v2.repair
    src_v2.intersection
    src_v2.visualization
    src_v2.runner
    src_v2.structural_mutations
